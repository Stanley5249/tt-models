# Copy to .env (git-ignored) and uncomment what this machine needs.
# just loads .env for every recipe; the justfile holds the defaults.

# Mesh the TT plugin opens.
# MESH_DEVICE=N300

# Address the serve recipes bind to.
# HOST=127.0.0.1
# PORT=8000

# KV pool per chip in GiB for serve-gemma4 (default 2.5); 0.2 forces
# preemption for `serve_check.py preempt`, with --max-model-len 4096.
# GEMMA4_KV_POOL_GIB=2.5

# Per-chunk prefill and per-step decode times in the server log.
# GEMMA4_TIMING=1
